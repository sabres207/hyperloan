{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "codegen": "graphql-codegen",
    "migration:run": "tsx ../node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "migration:create": "tsx ../node_modules/typeorm/cli.js migration:create"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dayjs": "^1.11.20",
    "decimal.js": "^10.6.0",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.25.0",
    "graphql-tag": "^2.12.6",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.6",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-resolvers": "^4.4.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0"
  }
}
